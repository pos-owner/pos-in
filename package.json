{
  "name": "pos-in",
  "version": "1.0.0",
  "private": true,
  "description": "Rent, tenants, UPI payments and maintenance for property owners in India. One Cloudflare Worker serves the PWA and the API.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "node scripts/migrations.mjs && vite build",
    "preview": "npm run build && node scripts/dev-api.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run check && npm run format:check && npm test && npm run deploy:dry",
    "db:generate": "drizzle-kit generate --config drizzle.d1.config.ts && node scripts/migrations.mjs",
    "db:sync": "node scripts/migrations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:list": "wrangler d1 migrations list DB --remote",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:setup": "node scripts/cf-setup.mjs",
    "cf:secret": "wrangler secret put",
    "cf:secrets": "wrangler secret list",
    "cf:tail": "wrangler tail --format pretty",
    "cf:backup": "node scripts/cf-backup.mjs",
    "cf:reset-link": "node scripts/cf-reset-link.mjs",
    "cf:rollback": "wrangler rollback",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "drizzle-orm": "1.0.0-rc.6",
    "hono": "^4.13.22",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "1.0.0-rc.6",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261123.1-beta",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.168.0"
  }
}
